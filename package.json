{
  "name": "predictee",
  "version": "1.0.0",
  "description": "PredicTEE - Privacy-Preserving AI Agent for Cross-Chain Prediction Markets powered by NEAR AI (TEE) & Chain Signatures",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix packages/frontend run dev",
    "build:frontend": "npm --prefix packages/frontend run build",
    "contracts:build": "npm --prefix packages/contracts run build",
    "contracts:test": "npm --prefix packages/contracts run test",
    "agent:test": "python packages/agent/test_agent.py",
    "test": "npm run contracts:test && python packages/agent/test_agent.py",
    "agent": "python packages/agent/agent.py"
  },
  "keywords": [
    "near",
    "near-ai",
    "chain-signatures",
    "polymarket",
    "prediction-market",
    "tee",
    "confidential-computing"
  ],
  "author": "PredicTEE Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
