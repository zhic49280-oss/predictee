# NEAR AI Cloud Confidential Computing Configuration
# Official Endpoint: https://cloud-api.near.ai/v1
# NOTE: Hardware attestation verification (GET /v1/attestation/report) is PUBLIC and works WITHOUT an API key!
# Set NEAR_AI_API_KEY (from https://cloud.near.ai or https://nearbuilders.org/dashboard) to enable live
# authenticated TEE chat completions (/v1/chat/completions) and hardware ECDSA signatures (/v1/signature/{chat_id}).
# NEVER commit your actual .env file with a secret key to GitHub.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
